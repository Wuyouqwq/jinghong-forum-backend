APP_ENV=development
PORT=8080
MYSQL_DSN=forum:forum@tcp(mysql:3306)/forum?charset=utf8mb4&parseTime=True&loc=Local
MYSQL_DATABASE=forum
MYSQL_USER=forum
MYSQL_PASSWORD=forum
MYSQL_ROOT_PASSWORD=root
